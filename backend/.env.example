# Availity REST / OAuth
# Defaults match the QA sandbox. Replace client id and secret with Availity app credentials.
AVAILITY_CLIENT_ID=sandbox
AVAILITY_CLIENT_SECRET=sandbox
AVAILITY_REALM=
AVAILITY_SCOPE=hipaa
AVAILITY_BASE_URL=https://api.availity.com
AVAILITY_TOKEN_URL=https://api.availity.com/availity/v1/token
AVAILITY_API_VERSION=v1
AVAILITY_SUBMITTER_ID=AV09311993
AVAILITY_RECEIVER_ID=030240928
AVAILITY_USAGE_INDICATOR=T

# Availity QA SFTP (qa-files.availity.com:22)
AVAILITY_SFTP_HOST=qa-files.availity.com
AVAILITY_SFTP_PORT=22
AVAILITY_SFTP_USERNAME=sandbox
AVAILITY_SFTP_PASSWORD=
AVAILITY_SFTP_PRIVATE_KEY_PATH=
AVAILITY_SFTP_SEND_PATH=/SendFiles
AVAILITY_SFTP_RECEIVE_PATH=/ReceiveFiles
AVAILITY_SFTP_OUTBOUND_PATH=/SendFiles
AVAILITY_SFTP_INBOUND_PATH=/ReceiveFiles

# Local UI work can boot without QA credentials. Set this to false before a real QA run.
AVAILITY_ALLOW_INCOMPLETE_CONFIG=true
AVAILITY_ALLOW_ENV_MISMATCH=false
AVAILITY_COVERAGE_POLL_ATTEMPTS=15
AVAILITY_COVERAGE_POLL_INTERVAL_MS=2000

# Optum (Change Healthcare) sandbox. Leave the secret empty until a real app credential is available.
OPTUM_CLIENT_ID=
OPTUM_CLIENT_SECRET=
OPTUM_BASE_URL=https://sandbox-apigw.optum.com
OPTUM_TOKEN_URL=https://sandbox-apigw.optum.com/apip/auth/v2/token
OPTUM_TRADING_PARTNER_ID=87726
OPTUM_277_REPORT_ID=X3000000.XX
OPTUM_835_REPORT_ID=R5000000.WA

# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
