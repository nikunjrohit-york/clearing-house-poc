# No defaults. No mocks. App refuses to start without these.
# The boot guard reads the process environment before Nest loads this file.
# Export it first: set -a && source .env && set +a && npm run start:dev

# Availity REST / OAuth
AVAILITY_CLIENT_ID=<REQUIRED — provisioned by Availity Client Services>
AVAILITY_CLIENT_SECRET=<REQUIRED — provisioned by Availity Client Services>
AVAILITY_SCOPE=hipaa
AVAILITY_BASE_URL=https://api.availity.com
AVAILITY_TOKEN_URL=https://api.availity.com/availity/v1/token
AVAILITY_API_VERSION=v1
AVAILITY_SUBMITTER_ID=<REQUIRED — provisioned by Availity Client Services>
AVAILITY_RECEIVER_ID=<REQUIRED — provisioned by Availity Client Services>
AVAILITY_USAGE_INDICATOR=T

# Availity SFTP. Host may stay on the QA gateway; credentials may not.
AVAILITY_SFTP_HOST=qa-files.availity.com
AVAILITY_SFTP_PORT=22
AVAILITY_SFTP_USERNAME=<REQUIRED — provisioned by Availity Client Services>
AVAILITY_SFTP_PASSWORD=<REQUIRED — provisioned by Availity Client Services>
# AVAILITY_SFTP_PRIVATE_KEY_PATH=<REQUIRED — provisioned by Availity Client Services>
AVAILITY_SFTP_SEND_PATH=/SendFiles
AVAILITY_SFTP_RECEIVE_PATH=/ReceiveFiles

AVAILITY_ALLOW_ENV_MISMATCH=false
AVAILITY_COVERAGE_POLL_ATTEMPTS=15
AVAILITY_COVERAGE_POLL_INTERVAL_MS=2000

# Optum (Change Healthcare). Separate from every AVAILITY_* value above.
OPTUM_CLIENT_ID=<REQUIRED — provisioned by Optum>
OPTUM_CLIENT_SECRET=<REQUIRED — provisioned by Optum>
OPTUM_BASE_URL=<REQUIRED — provisioned by Optum>
OPTUM_TOKEN_URL=<REQUIRED — provisioned by Optum>
OPTUM_TRADING_PARTNER_ID=<REQUIRED — provisioned by Optum>
OPTUM_277_REPORT_ID=<REQUIRED — provisioned by Optum>
OPTUM_835_REPORT_ID=<REQUIRED — provisioned by Optum>

# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
